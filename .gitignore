# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
__pycache__/
*.pyc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# claude code local settings
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Local-only secrets scratch files — never commit
.circle-testnet-entity-secret.tmp

recovery_file_*.dat

# Code-quality collector output — fully regenerable from source via `npm run quality:collect`,
# so committing it would just be diff noise on every run. docs/quality/circular-baseline.json,
# docs/quality/trend.md, docs/quality/audit-*.md, and docs/quality/raw/red-flag-counts.json ARE
# committed deliberately (see docs/quality/README.md) — persisted loop history/state, not scratch
# output. Ignoring individual files rather than the whole raw/ directory because git can't
# re-include a file whose parent directory is excluded.
/docs/quality/raw/churn.json
/docs/quality/raw/madge.json
/docs/quality/raw/madge-circular.json
/docs/quality/raw/passthrough.json
/docs/quality/raw/comment-overlap.json
/docs/quality/raw/jscpd/
/docs/quality/complexity-score.json
