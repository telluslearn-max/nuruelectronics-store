generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

enum OrderSource {
  shopify
  manual
}

enum EstimateStatus {
  draft
  sent
  accepted
  declined
  expired
}

enum InvoiceStatus {
  draft
  sent
  partially_paid
  paid
  void
}

enum DeliveryStatus {
  pending
  delivered
}

enum PaymentMethod {
  cash
  mpesa
}

// Sequence key for human-readable document numbers (EST-2026-0001, etc).
enum DocumentType {
  estimate
  invoice
  receipt
  delivery_note
  bill
  payslip
}

enum ExpenseCategory {
  cogs
  sga
  other
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum BillStatus {
  unpaid
  partially_paid
  paid
}

enum PettyCashEntryType {
  expense
  replenishment
}

enum PayRunStatus {
  draft
  finalized
}

// ---------------------------------------------------------------------------
// Customers & Orders (Shopify or manual/WhatsApp)
// ---------------------------------------------------------------------------

model Customer {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  phone             String?
  shopifyCustomerId String?
  createdAt         DateTime @default(now())

  orders Order[]
}

model Order {
  id               String      @id @default(cuid())
  source           OrderSource
  shopifyOrderId   String?     @unique
  shopifyOrderName String?
  currencyCode     String      @default("KES")
  note             String?
  createdAt        DateTime    @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  items        OrderItem[]
  estimates    Estimate[]
  invoice      Invoice?
  deliveryNote DeliveryNote?

  @@index([customerId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title     String
  variantId String?
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Estimates (quotes) — revisable, public accept/decline via accessToken
// ---------------------------------------------------------------------------

model Estimate {
  id            String         @id @default(cuid())
  number        String         @unique
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  status        EstimateStatus @default(draft)
  validUntil    DateTime
  accessToken   String         @unique
  subtotal      Decimal        @db.Decimal(10, 2)
  taxTotal      Decimal        @default(0) @db.Decimal(10, 2)
  shippingTotal Decimal        @default(0) @db.Decimal(10, 2)
  discountTotal Decimal        @default(0) @db.Decimal(10, 2)
  total         Decimal        @db.Decimal(10, 2)
  note          String?
  sentAt        DateTime?
  respondedAt   DateTime?
  createdAt     DateTime       @default(now())

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Invoices — one per order, tracks running balance across receipts
// ---------------------------------------------------------------------------

model Invoice {
  id                 String        @id @default(cuid())
  number             String        @unique
  orderId            String        @unique
  order              Order         @relation(fields: [orderId], references: [id])
  status             InvoiceStatus @default(draft)
  subtotal           Decimal       @db.Decimal(10, 2)
  taxTotal           Decimal       @default(0) @db.Decimal(10, 2)
  shippingTotal      Decimal       @default(0) @db.Decimal(10, 2)
  discountTotal      Decimal       @default(0) @db.Decimal(10, 2)
  total              Decimal       @db.Decimal(10, 2)
  amountPaid         Decimal       @default(0) @db.Decimal(10, 2)
  note               String?
  dueAt              DateTime?
  issuedAt           DateTime?
  sentAt             DateTime?
  voidedAt           DateTime?
  lastReminderSentAt DateTime?
  createdAt          DateTime      @default(now())

  receipts Receipt[]
}

model Receipt {
  id        String        @id @default(cuid())
  number    String        @unique
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  reference String?
  paidAt    DateTime
  createdAt DateTime      @default(now())

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Delivery notes — one per order, no split shipments
// ---------------------------------------------------------------------------

model DeliveryNote {
  id              String         @id @default(cuid())
  number          String         @unique
  orderId         String         @unique
  order           Order          @relation(fields: [orderId], references: [id])
  status          DeliveryStatus @default(pending)
  recipientName   String
  recipientPhone  String?
  deliveryAddress String
  deliveryMethod  String?
  receivedBy      String?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())

  // Rider who completed the delivery (Employee with role "rider") — set when marking delivered,
  // so gig-delivery volume/payouts can be reported (see riders-impact report).
  riderId String?
  rider   Employee? @relation(fields: [riderId], references: [id])

  @@index([riderId])
}

// One row per (type, year); atomically incremented in a transaction to mint numbers.
model DocumentSequence {
  type  DocumentType
  year  Int
  value Int          @default(0)

  @@id([type, year])
}

// ---------------------------------------------------------------------------
// Expenses — feeds the P&L's Expenses side and the Ledger
// ---------------------------------------------------------------------------

enum ExpensePaymentSource {
  cash
  mpesa
  petty_cash
}

model Expense {
  id          String               @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  subcategory String
  amount      Decimal              @db.Decimal(10, 2)
  description String?
  paidFrom    ExpensePaymentSource
  createdAt   DateTime             @default(now())
}

// ---------------------------------------------------------------------------
// General Ledger — Chart of Accounts + double-entry Journal
// ---------------------------------------------------------------------------

model Account {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  type      AccountType
  createdAt DateTime    @default(now())

  journalLines JournalLine[]
}

model JournalEntry {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  sourceType  String?
  sourceId    String?
  createdAt   DateTime @default(now())

  lines JournalLine[]
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(10, 2)
  credit         Decimal      @default(0) @db.Decimal(10, 2)

  @@index([accountId])
  @@index([journalEntryId])
}

// ---------------------------------------------------------------------------
// Petty Cash Book
// ---------------------------------------------------------------------------

model PettyCashFund {
  id          String   @id @default(cuid())
  name        String   @default("Shop Petty Cash")
  floatAmount Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  entries PettyCashEntry[]
}

model PettyCashEntry {
  id          String             @id @default(cuid())
  fundId      String
  fund        PettyCashFund      @relation(fields: [fundId], references: [id])
  type        PettyCashEntryType
  amount      Decimal            @db.Decimal(10, 2)
  description String
  date        DateTime
  createdAt   DateTime           @default(now())

  @@index([fundId])
}

// ---------------------------------------------------------------------------
// Creditors Ledger — Suppliers, Bills, Payments
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  bills Bill[]
}

model Bill {
  id          String          @id @default(cuid())
  number      String          @unique
  supplierId  String
  supplier    Supplier        @relation(fields: [supplierId], references: [id])
  description String
  category    ExpenseCategory @default(cogs)
  amount      Decimal         @db.Decimal(10, 2)
  amountPaid  Decimal         @default(0) @db.Decimal(10, 2)
  status      BillStatus      @default(unpaid)
  billDate    DateTime
  dueAt       DateTime?
  createdAt   DateTime        @default(now())

  payments SupplierPayment[]

  @@index([supplierId])
}

model SupplierPayment {
  id        String        @id @default(cuid())
  billId    String
  bill      Bill          @relation(fields: [billId], references: [id])
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  reference String?
  paidAt    DateTime
  createdAt DateTime      @default(now())

  @@index([billId])
}

// ---------------------------------------------------------------------------
// Fixed Asset Register
// ---------------------------------------------------------------------------

model FixedAsset {
  id              String    @id @default(cuid())
  name            String
  category        String
  purchaseDate    DateTime
  purchaseCost    Decimal   @db.Decimal(10, 2)
  salvageValue    Decimal   @default(0) @db.Decimal(10, 2)
  usefulLifeYears Int
  disposedAt      DateTime?
  disposalValue   Decimal?  @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Payroll Register (record-keeping only — see compliance note in docs)
// ---------------------------------------------------------------------------

model Employee {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  role      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  payslips  Payslip[]
  deliveries DeliveryNote[]
}

model PayRun {
  id          String       @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  status      PayRunStatus @default(draft)
  createdAt   DateTime     @default(now())

  payslips Payslip[]
}

model Payslip {
  id         String    @id @default(cuid())
  number     String    @unique
  payRunId   String
  payRun     PayRun    @relation(fields: [payRunId], references: [id])
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  grossPay   Decimal   @db.Decimal(10, 2)
  netPay     Decimal   @db.Decimal(10, 2)
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  deductions PayslipDeduction[]

  @@index([payRunId])
  @@index([employeeId])
}

model PayslipDeduction {
  id        String  @id @default(cuid())
  payslipId String
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  type      String
  amount    Decimal @db.Decimal(10, 2)
}

// ---------------------------------------------------------------------------
// Admin login lockout
// ---------------------------------------------------------------------------

model AdminLoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// AI concierge rate limiting — /api/concierge/chat and /voice-turn are
// unauthenticated and each drive several paid Vertex/Gemini calls, so requests
// are capped per IP over a sliding window (see src/lib/concierge/rate-limit.ts).
// ---------------------------------------------------------------------------

model ConciergeRequestLog {
  id        String   @id @default(cuid())
  ipAddress String
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}

// ---------------------------------------------------------------------------
// Business settings — singleton row, fixed id "settings"
// ---------------------------------------------------------------------------

model Settings {
  id                               String   @id @default("settings")
  companyName                      String   @default("NURU Electronics")
  companyEmail                     String?
  companyPhone                     String?
  companyAddress                   String?
  logoUrl                          String?
  defaultTaxRatePercent            Decimal  @default(0) @db.Decimal(5, 2)
  currencyCode                     String   @default("KES")
  documentNumberPrefixEstimate     String?
  documentNumberPrefixInvoice      String?
  documentNumberPrefixReceipt      String?
  documentNumberPrefixDeliveryNote String?
  documentNumberPrefixBill         String?
  documentNumberPrefixPayslip      String?
  updatedAt                        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Product embeddings — Vertex AI text-embedding-004 vectors, keyed by Shopify
// product handle, for semantic search (see src/lib/search/semantic-search.ts)
// ---------------------------------------------------------------------------

model ProductEmbedding {
  handle    String   @id
  embedding Float[]
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Audit log — destructive/financial admin actions only
// ---------------------------------------------------------------------------

model AdminAuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
