generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

enum OrderSource {
  shopify
  manual
}

enum EstimateStatus {
  draft
  sent
  accepted
  declined
  expired
}

enum InvoiceStatus {
  draft
  sent
  partially_paid
  paid
  void
}

enum DeliveryStatus {
  pending
  delivered
}

enum PaymentMethod {
  cash
  mpesa
}

// Sequence key for human-readable document numbers (EST-2026-0001, etc).
enum DocumentType {
  estimate
  invoice
  receipt
  delivery_note
  bill
  payslip
}

enum ExpenseCategory {
  cogs
  sga
  other
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum BillStatus {
  unpaid
  partially_paid
  paid
}

enum PettyCashEntryType {
  expense
  replenishment
}

enum PayRunStatus {
  draft
  finalized
}

// ---------------------------------------------------------------------------
// Customers & Orders (Shopify or manual/WhatsApp)
// ---------------------------------------------------------------------------

model Customer {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  phone             String?
  shopifyCustomerId String?
  createdAt         DateTime @default(now())

  orders Order[]
}

model Order {
  id               String      @id @default(cuid())
  source           OrderSource
  shopifyOrderId   String?     @unique
  shopifyOrderName String?
  currencyCode     String      @default("KES")
  note             String?
  createdAt        DateTime    @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  items        OrderItem[]
  estimates    Estimate[]
  invoice      Invoice?
  deliveryNote DeliveryNote?

  @@index([customerId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title       String
  // Free-text notes shown alongside the title (e.g. serial number, condition) — most useful
  // for manual/off-platform sales of used or serialized electronics.
  description String?
  variantId   String?
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  // Per-line amount knocked off qty * unitPrice before it lands in lineTotal.
  discount    Decimal @default(0) @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Estimates (quotes) — revisable, public accept/decline via accessToken
// ---------------------------------------------------------------------------

model Estimate {
  id            String         @id @default(cuid())
  number        String         @unique
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  status        EstimateStatus @default(draft)
  validUntil    DateTime
  accessToken   String         @unique
  subtotal      Decimal        @db.Decimal(10, 2)
  taxTotal      Decimal        @default(0) @db.Decimal(10, 2)
  shippingTotal Decimal        @default(0) @db.Decimal(10, 2)
  discountTotal Decimal        @default(0) @db.Decimal(10, 2)
  total         Decimal        @db.Decimal(10, 2)
  note          String?
  sentAt        DateTime?
  respondedAt   DateTime?
  createdAt     DateTime       @default(now())

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Invoices — one per order, tracks running balance across receipts
// ---------------------------------------------------------------------------

model Invoice {
  id                 String        @id @default(cuid())
  number             String        @unique
  orderId            String        @unique
  order              Order         @relation(fields: [orderId], references: [id])
  status             InvoiceStatus @default(draft)
  subtotal           Decimal       @db.Decimal(10, 2)
  taxTotal           Decimal       @default(0) @db.Decimal(10, 2)
  shippingTotal      Decimal       @default(0) @db.Decimal(10, 2)
  discountTotal      Decimal       @default(0) @db.Decimal(10, 2)
  total              Decimal       @db.Decimal(10, 2)
  amountPaid         Decimal       @default(0) @db.Decimal(10, 2)
  note               String?
  dueAt              DateTime?
  issuedAt           DateTime?
  sentAt             DateTime?
  voidedAt           DateTime?
  lastReminderSentAt DateTime?
  createdAt          DateTime      @default(now())

  receipts Receipt[]
}

model Receipt {
  id        String        @id @default(cuid())
  number    String        @unique
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  reference String?
  paidAt    DateTime
  createdAt DateTime      @default(now())

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Delivery notes — one per order, no split shipments
// ---------------------------------------------------------------------------

model DeliveryNote {
  id              String         @id @default(cuid())
  number          String         @unique
  orderId         String         @unique
  order           Order          @relation(fields: [orderId], references: [id])
  status          DeliveryStatus @default(pending)
  recipientName   String
  recipientPhone  String?
  deliveryAddress String
  deliveryMethod  String?
  receivedBy      String?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())

  // Rider who completed the delivery (Employee with role "rider") — set when marking delivered,
  // so gig-delivery volume/payouts can be reported (see riders-impact report).
  riderId String?
  rider   Employee? @relation(fields: [riderId], references: [id])

  @@index([riderId])
}

// One row per (type, year); atomically incremented in a transaction to mint numbers.
model DocumentSequence {
  type  DocumentType
  year  Int
  value Int          @default(0)

  @@id([type, year])
}

// ---------------------------------------------------------------------------
// Expenses — feeds the P&L's Expenses side and the Ledger
// ---------------------------------------------------------------------------

enum ExpensePaymentSource {
  cash
  mpesa
  petty_cash
}

model Expense {
  id          String               @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  subcategory String
  amount      Decimal              @db.Decimal(10, 2)
  description String?
  paidFrom    ExpensePaymentSource
  createdAt   DateTime             @default(now())
}

// ---------------------------------------------------------------------------
// General Ledger — Chart of Accounts + double-entry Journal
// ---------------------------------------------------------------------------

model Account {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  type      AccountType
  createdAt DateTime    @default(now())

  journalLines JournalLine[]
}

model JournalEntry {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  sourceType  String?
  sourceId    String?
  createdAt   DateTime @default(now())

  lines JournalLine[]
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(10, 2)
  credit         Decimal      @default(0) @db.Decimal(10, 2)

  @@index([accountId])
  @@index([journalEntryId])
}

// ---------------------------------------------------------------------------
// Petty Cash Book
// ---------------------------------------------------------------------------

model PettyCashFund {
  id          String   @id @default(cuid())
  name        String   @default("Shop Petty Cash")
  floatAmount Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  entries PettyCashEntry[]
}

model PettyCashEntry {
  id          String             @id @default(cuid())
  fundId      String
  fund        PettyCashFund      @relation(fields: [fundId], references: [id])
  type        PettyCashEntryType
  amount      Decimal            @db.Decimal(10, 2)
  description String
  date        DateTime
  createdAt   DateTime           @default(now())

  @@index([fundId])
}

// ---------------------------------------------------------------------------
// Creditors Ledger — Suppliers, Bills, Payments
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  bills Bill[]
}

model Bill {
  id          String          @id @default(cuid())
  number      String          @unique
  supplierId  String
  supplier    Supplier        @relation(fields: [supplierId], references: [id])
  description String
  category    ExpenseCategory @default(cogs)
  amount      Decimal         @db.Decimal(10, 2)
  amountPaid  Decimal         @default(0) @db.Decimal(10, 2)
  status      BillStatus      @default(unpaid)
  billDate    DateTime
  dueAt       DateTime?
  createdAt   DateTime        @default(now())

  payments SupplierPayment[]

  @@index([supplierId])
}

model SupplierPayment {
  id        String        @id @default(cuid())
  billId    String
  bill      Bill          @relation(fields: [billId], references: [id])
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  reference String?
  paidAt    DateTime
  createdAt DateTime      @default(now())

  @@index([billId])
}

// ---------------------------------------------------------------------------
// Fixed Asset Register
// ---------------------------------------------------------------------------

model FixedAsset {
  id              String    @id @default(cuid())
  name            String
  category        String
  purchaseDate    DateTime
  purchaseCost    Decimal   @db.Decimal(10, 2)
  salvageValue    Decimal   @default(0) @db.Decimal(10, 2)
  usefulLifeYears Int
  disposedAt      DateTime?
  disposalValue   Decimal?  @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Payroll Register (record-keeping only — see compliance note in docs)
// ---------------------------------------------------------------------------

model Employee {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  role      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  payslips   Payslip[]
  deliveries DeliveryNote[]
}

model PayRun {
  id          String       @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  status      PayRunStatus @default(draft)
  createdAt   DateTime     @default(now())

  payslips Payslip[]
}

model Payslip {
  id         String    @id @default(cuid())
  number     String    @unique
  payRunId   String
  payRun     PayRun    @relation(fields: [payRunId], references: [id])
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  grossPay   Decimal   @db.Decimal(10, 2)
  netPay     Decimal   @db.Decimal(10, 2)
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  deductions PayslipDeduction[]

  @@index([payRunId])
  @@index([employeeId])
}

model PayslipDeduction {
  id        String  @id @default(cuid())
  payslipId String
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  type      String
  amount    Decimal @db.Decimal(10, 2)
}

// ---------------------------------------------------------------------------
// Admin login lockout
// ---------------------------------------------------------------------------

model AdminLoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// AI concierge rate limiting — /api/concierge/chat and /voice-turn are
// unauthenticated and each drive several paid Vertex/Gemini calls, so requests
// are capped per IP over a sliding window (see src/lib/concierge/rate-limit.ts).
// ---------------------------------------------------------------------------

model ConciergeRequestLog {
  id        String   @id @default(cuid())
  ipAddress String
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}

// ---------------------------------------------------------------------------
// Business settings — singleton row, fixed id "settings"
// ---------------------------------------------------------------------------

model Settings {
  id                               String   @id @default("settings")
  companyName                      String   @default("NURU Electronics")
  companyEmail                     String?
  companyPhone                     String?
  companyAddress                   String?
  logoUrl                          String?
  defaultTaxRatePercent            Decimal  @default(0) @db.Decimal(5, 2)
  currencyCode                     String   @default("KES")
  documentNumberPrefixEstimate     String?
  documentNumberPrefixInvoice      String?
  documentNumberPrefixReceipt      String?
  documentNumberPrefixDeliveryNote String?
  documentNumberPrefixBill         String?
  documentNumberPrefixPayslip      String?
  updatedAt                        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Product embeddings — Vertex AI text-embedding-004 vectors, keyed by Shopify
// product handle, for semantic search (see src/lib/search/semantic-search.ts)
// ---------------------------------------------------------------------------

model ProductEmbedding {
  handle    String   @id
  embedding Float[]
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Audit log — destructive/financial admin actions only
// ---------------------------------------------------------------------------

model AdminAuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Return/refund cases — decided by the AI concierge under a fixed policy
// (see src/lib/support/return-policy.ts, mirrors /legal/refund-policy), or
// escalated to staff. `decidedBy` is "agent" unless a human later overrides
// an escalated case from /admin/support.
// ---------------------------------------------------------------------------

enum ReturnCaseReason {
  change_of_mind
  damaged
  wrong_item
  missing_item
  warranty
}

enum ReturnCaseStatus {
  approved
  denied
  escalated
  refunded
}

model ReturnCase {
  id               String           @id @default(cuid())
  shopifyOrderId   String
  shopifyOrderName String
  customerEmail    String
  reason           ReturnCaseReason
  description      String
  status           ReturnCaseStatus
  decisionBasis    String
  decidedBy        String           @default("agent")
  refundAmount     Decimal?         @db.Decimal(10, 2)
  refundChannel    String?
  journalEntryId   String?
  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?

  @@index([shopifyOrderId])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Capital Circle — the firewalled, USDC-funded pool that hunts for profit
// outside electronics retail (see src/lib/capital-circle/). Deliberately
// separate from every model above: this pool can only ever lose what's
// already inside it, and never has any claim on the core ledger.
//
// Phase A (current): no real Circle wallet exists yet (owner hasn't
// completed Circle's mainnet/KYB signup — see the project's Two Circles
// plan doc). Positions are written with status "simulated" against real,
// live Polymarket market data, with no wallet or funds attached.
// Phase B: once a real mainnet agent wallet exists, CapitalCircleWallet
// rows track its address and the spending-policy caps configured on it
// (via `circle wallet limit set`), and positions can move to "executed".
// ---------------------------------------------------------------------------

enum CapitalCircleWalletStatus {
  pending
  active
  frozen
}

model CapitalCircleWallet {
  id             String                    @id @default(cuid())
  /// Circle's own internal wallet id (required by their SDK for balance/
  /// signing calls) — distinct from `address`, the on-chain address.
  circleWalletId String?                   @unique
  address        String?                   @unique
  chain          String                    @default("polygon")
  status         CapitalCircleWalletStatus @default(pending)
  perTxCapUsd    Decimal?                  @db.Decimal(10, 2)
  dailyCapUsd    Decimal?                  @db.Decimal(10, 2)
  weeklyCapUsd   Decimal?                  @db.Decimal(10, 2)
  monthlyCapUsd  Decimal?                  @db.Decimal(10, 2)
  /// Circuit breaker. Set by the sizing layer when the trailing-week drawdown or a losing
  /// streak crosses its limit; while set, no new position is approved. Cleared only by a
  /// human from the admin report — a run of losses is either variance or a broken thesis
  /// generator, and the code cannot tell which, so it stops rather than compounding the
  /// second case.
  pausedAt       DateTime?
  pausedReason   String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  positions CapitalCirclePosition[]
  sweeps    CapitalCircleSweep[]
}

enum CapitalCirclePositionStatus {
  simulated
  approved
  executed
  rejected
  /// Refused by the code-side edge gate (see trade-policy.ts) rather than by a cap. Kept
  /// distinct from `rejected` so "the model wanted a trade with no expected value" is
  /// countable on its own — it's the main measure of whether the model's estimates are
  /// improving, and it's noise if mixed in with size-capped and failed-order rows.
  edge_rejected
  /// Closed early by the position manager (take-profit or stop) rather than held to
  /// resolution. resultUsd is realized at exitPrice, not at the market's final price.
  exited
}

model CapitalCirclePosition {
  id         String                      @id @default(cuid())
  walletId   String?
  wallet     CapitalCircleWallet?        @relation(fields: [walletId], references: [id])
  venue      String                      @default("polymarket")
  marketId   String
  tokenId    String?
  question   String
  thesis     String
  sizeUsd    Decimal                     @db.Decimal(10, 2)
  /// The price actually used for settlement — since the overhaul, the ask-side price the
  /// order book quoted at decision time, not a midpoint. The settlement job divides sizeUsd
  /// by this to get an implied share count, so a resolved market's win/loss is
  /// shares * finalPrice - sizeUsd rather than a flat win/lose guess. Using a midpoint here
  /// (the old behaviour) silently credited every position half the spread it never earned.
  entryPrice Decimal?                    @db.Decimal(6, 4)
  /// The model's own stated conviction in its thesis, 0-100 — distinct from entryPrice (the
  /// market's implied probability): entryPrice is what the crowd thinks, confidencePct is what
  /// the model thinks. A model betting against a skewed market should often show low entryPrice
  /// alongside high confidencePct, or vice versa — the gap between them is the whole thesis.
  /// Scored against outcomes as a Brier score (see track-record.ts) and fed back into the next
  /// cycle, which is what turns it from a stored number into a signal.
  confidencePct Int?
  /// Shrunk probability minus effective entry minus modelled costs, at decision time — the
  /// expected value this position was taken for. Comparing this against realized outcomes is
  /// how a threshold gets tuned from data instead of taste.
  edgePct        Decimal? @db.Decimal(6, 4)
  /// Book state at entry, kept so a post-mortem can separate "the thesis was wrong" from
  /// "the fill was expensive".
  spreadAtEntry  Decimal? @db.Decimal(6, 4)
  bestAskAtEntry Decimal? @db.Decimal(6, 4)
  /// Live: the price actually filled, derived from the CLOB order response. Simulated: the
  /// ask we assumed we'd pay. Distinct from entryPrice so a future fill-vs-quote comparison
  /// can measure real slippage.
  fillPrice      Decimal? @db.Decimal(6, 4)
  /// Modelled (simulated) or actual (live) cost drag, subtracted at settlement.
  feesUsd        Decimal? @db.Decimal(10, 2)
  /// The raw Kelly fraction the sizing calc produced before the fractional multiplier and caps.
  kellyFraction  Decimal? @db.Decimal(6, 4)
  /// The cycle that produced this position — joins a trade to the market slate, news context,
  /// and track record that were in front of the model when it decided.
  cycleId        String?
  /// The market's own resolution time, captured at entry so settlement can void a position
  /// whose market never closes instead of leaving it open forever.
  marketEndDate  DateTime?
  /// Polymarket event grouping. Two outcomes of the same event are the same wager, so the
  /// portfolio limits treat them as one.
  eventId        String?
  /// Coarse topic bucket (crypto/sports/politics/economics/other) for per-category track records.
  category       String?
  /// The individual ensemble samples behind confidencePct, kept so a wide disagreement can be
  /// distinguished from a confident estimate after the fact.
  probEstimates  Json?
  /// resolution | take_profit | stop | voided
  exitReason     String?
  /// Price at which an early exit was booked (null for held-to-resolution positions).
  exitPrice      Decimal? @db.Decimal(6, 4)
  status     CapitalCirclePositionStatus @default(simulated)
  txHash     String?
  resultUsd  Decimal?                    @db.Decimal(10, 2)
  createdAt  DateTime                    @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([walletId])
  /// Serves the dedupe check on every record_position: "am I already holding this market?"
  @@index([marketId, resolvedAt])
}

/// One row per hourly cycle — what the agent saw and what it decided.
///
/// Exists because the old design kept no record of a cycle at all beyond the model's own
/// prose summary, so "why did it pass on everything last Tuesday" was unanswerable. Storing
/// the injected context alongside the decision makes each cycle reconstructable.
model CapitalCircleCycleLog {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  candidateCount Int       @default(0)
  toolCallCount  Int       @default(0)
  /// traded | passed | edge_rejected | error | inconclusive
  action         String    @default("passed")
  summary        String    @default("")
  /// The track record and calibration figures injected into this cycle's prompt.
  contextSnapshot Json?
  /// The grounded-search digest used for this cycle's estimates, if the pre-pass succeeded.
  newsContext    String?
  positionIds    String[]  @default([])

  @@index([startedAt])
}

/// Every market the agent priced, whether or not it traded it.
///
/// This is what makes the strategy measurable. Because the scoring stage prices the whole
/// slate and settlement backfills each row's real outcome, these accumulate into a labeled
/// dataset of (market, model probability, price, outcome) — including the markets that were
/// passed on. That supports honest calibration measurement and counterfactual evaluation of
/// policy thresholds (policy-eval.ts), neither of which is possible from taken trades alone,
/// where the sample is selected precisely on the model's own judgement.
model CapitalCircleCandidateSnapshot {
  id                String   @id @default(cuid())
  cycleId           String
  marketId          String
  tokenId           String
  question          String
  category          String?
  eventId           String?
  bestAsk           Decimal? @db.Decimal(6, 4)
  bestBid           Decimal? @db.Decimal(6, 4)
  spread            Decimal? @db.Decimal(6, 4)
  liquidityUsd      Decimal? @db.Decimal(14, 2)
  volume24hUsd      Decimal? @db.Decimal(14, 2)
  hoursToResolution Decimal? @db.Decimal(8, 2)
  /// The outcome's own name ("Yes", "T1", "Arsenal") as shown to the model. Without it a
  /// resolved row cannot be checked for a probability recorded against the wrong side of a
  /// market, which is the failure the ref/name verification in scoring-slate.ts exists to stop.
  outcomeLabel      String?
  /// The market price this outcome was quoted at when the model priced it. Distinct from
  /// bestAsk/bestBid, which are the market's own top-of-book and are not per-token on Gamma.
  /// This is what separates an estimate the model reasoned to from one it copied — the two are
  /// identical in every other field and mean opposite things about whether it forecast anything.
  shownPrice        Decimal? @db.Decimal(6, 4)
  /// The ensembled probability the model assigned this outcome.
  modelProbability  Decimal? @db.Decimal(6, 4)
  /// Spread between ensemble samples — high means the estimate was unstable, not confident.
  disagreement      Decimal? @db.Decimal(6, 4)
  traded            Boolean  @default(false)
  /// Backfilled by settlement once the market closes: 1 if this outcome won, 0 if it lost.
  resolvedOutcome   Int?
  resolvedAt        DateTime?
  createdAt         DateTime @default(now())

  @@index([cycleId])
  @@index([marketId, resolvedAt])
  @@index([resolvedAt])
}

/// A subscribed browser/PWA endpoint for Web Push — the admin dashboard is already an
/// installable PWA (see public/admin-manifest.webmanifest), so this lets it receive a real
/// push notification (e.g. "Capital Circle took a position") without any third-party
/// messaging account. Single-owner site, so there's no userId — any subscription here is the
/// admin's.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  authKey   String
  createdAt DateTime @default(now())
}

// The weekly "take 40% of real profit, stage it for conversion" step. This
// model only ever gets a status flip from a human (see
// src/lib/capital-circle/sweep-actions.ts) after they've manually converted
// USD to USDC via Circle Mint/an exchange and sent it to the wallet — no
// code path here calls a payment or exchange API.
enum CapitalCircleSweepStatus {
  pending
  confirmed
}

model CapitalCircleSweep {
  id                  String                   @id @default(cuid())
  /// Monday 00:00 of the week this sweep covers.
  weekStart           DateTime
  /// Exclusive — the following Monday 00:00.
  weekEnd             DateTime
  totalProfitUsd      Decimal                  @db.Decimal(10, 2)
  splitPercent        Decimal                  @default(40) @db.Decimal(5, 2)
  sweepAmountUsd      Decimal                  @db.Decimal(10, 2)
  status              CapitalCircleSweepStatus @default(pending)
  /// Set by the Circle webhook (see /api/webhooks/circle) when it detects a matching
  /// inbound USDC transfer — pre-fills the confirm form but never confirms on its own.
  detectedUsdcAmount  Decimal?                 @db.Decimal(10, 2)
  detectedAt          DateTime?
  detectedTxHash      String?
  confirmedUsdcAmount Decimal?                 @db.Decimal(10, 2)
  confirmedBy         String?
  confirmedAt         DateTime?
  walletId            String?
  wallet              CapitalCircleWallet?     @relation(fields: [walletId], references: [id])
  createdAt           DateTime                 @default(now())

  @@unique([weekStart])
  @@index([status, weekStart])
}

// ---------------------------------------------------------------------------
// Product Intelligence Layer — NURU's own structured product knowledge, kept
// deliberately separate from Shopify (the commerce/catalogue system of record)
// and from the ERP ledger models above. Shopify stays the authority on what's
// for sale and at what price; these models are the authority on what a product
// *is* — normalized specifications, where each fact came from, how much it can
// be trusted, and (added in later migrations) benchmark anchors, NURU scores,
// and product relationships.
//
// Join key to Shopify is the product handle / product id. A ProductProfile is
// created and refreshed by the nightly catalogue reconcile job; nothing here is
// edited by hand through an admin screen. See src/lib/intelligence/.
// ---------------------------------------------------------------------------

/// How much a single stored specification can be trusted. Assigned from the
/// source it came from, not by a human (there is no verification UI): a value
/// from NURU's own maintained spec sheet is `verified`; a Shopify `specs`
/// metafield is `high`; a figure pulled by an AI grounded-search pass is `low`
/// until something better replaces it. The comparison engine excludes anything
/// below a per-use floor rather than presenting a guess as fact.
enum SpecConfidence {
  verified
  high
  medium
  low
  unknown
}

/// Where a stored fact came from. Drives the confidence assigned to every
/// SpecValue / BenchmarkObservation that cites it (see
/// confidenceForSourceType in src/lib/intelligence/normalize.ts).
enum IntelSourceType {
  /// NURU's own hand-maintained spec sheet (CSV import). Treated as verified.
  nuru_csv
  /// A Shopify product metafield in the "specs" namespace.
  shopify_metafield
  /// A manufacturer specification page or data sheet.
  manufacturer
  /// A third-party benchmark database (Geekbench, AnTuTu, 3DMark, DXOMARK).
  benchmark_db
  /// A Gemini grounded-search pass. Lowest confidence — always superseded by a
  /// real source when one becomes available.
  ai_grounded
  /// Reserved: a manual correction. No code path writes this yet (no admin UI).
  manual
}

/// One row per Shopify product NURU has built product intelligence for. Created
/// and kept in sync by the nightly reconcile job (src/lib/intelligence/sync.ts,
/// added in a later PR); never hand-edited.
model ProductProfile {
  id               String   @id @default(cuid())
  /// Shopify's stable product id (gid). The durable join key.
  shopifyProductId String   @unique
  /// Shopify product handle — the id used everywhere else in the app.
  handle           String   @unique
  /// Category schema id this profile is scored against, e.g. "smartphone".
  /// A plain string, not an enum, so a new category is a code change in
  /// src/lib/intelligence/schema/ with no migration.
  category         String
  brand            String?
  productFamily    String?
  model            String?
  generation       String?
  releaseYear      Int?
  /// 0.000–1.000: share of the category schema's attributes that have at least
  /// one SpecValue at `low` confidence or better. Recomputed on every sync.
  dataCompleteness Decimal  @default(0) @db.Decimal(4, 3)
  firstSeenAt      DateTime @default(now())
  lastSyncedAt     DateTime @default(now())
  updatedAt        DateTime @updatedAt

  specValues SpecValue[]
  nuruScore  NuruScore?

  @@index([category])
}

/// A citable origin for one or more stored facts. One import run (a CSV upload,
/// one product's grounded-search pass) creates one IntelSource that many
/// SpecValue rows then reference, so provenance is recorded once, not copied
/// onto every field.
model IntelSource {
  id          String          @id @default(cuid())
  type        IntelSourceType
  /// Human-readable origin, e.g. "NURU spec sheet (2026-09 import)", "GSMArena".
  label       String
  /// URL or bibliographic reference where the fact can be re-checked.
  reference   String?
  /// When the data was observed at the source (not when the row was written).
  retrievedAt DateTime        @default(now())
  createdAt   DateTime        @default(now())

  specValues SpecValue[]

  @@index([type])
}

/// One normalized specification for one product, from one source. Multiple
/// sources for the same (profile, key) coexist as separate rows; readers pick
/// the highest-confidence one and fall back down the ladder. Re-importing the
/// same source updates its row in place via the composite unique key.
model SpecValue {
  id              String         @id @default(cuid())
  profileId       String
  profile         ProductProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Attribute key from the category schema, e.g. "refresh_rate_hz".
  key             String
  /// Exactly what the source said, verbatim: "up to 120 Hz".
  rawValue        String
  /// Machine-readable form produced by the normalization engine. Numbers are
  /// stored as their decimal string ("120"), booleans as "true"/"false", enums
  /// as the canonical token. Null when the raw value could not be normalized —
  /// which is itself a signal, distinct from the attribute being absent.
  normalizedValue String?
  /// Canonical unit for the normalized value ("hz", "mah", "gb"), or null for
  /// unitless / enum / boolean attributes.
  unit            String?
  confidence      SpecConfidence
  sourceId        String
  source          IntelSource    @relation(fields: [sourceId], references: [id])
  /// When this fact was collected at its source — copied from IntelSource at
  /// write time so a "specs verified N days ago" read needs no join.
  collectedAt     DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([profileId, key, sourceId])
  @@index([profileId, key])
}


/// The NURU Score cache for one product — see src/lib/intelligence/scoring/.
/// Deterministically recomputed (never model-written) whenever a sync writes
/// new spec values for the product; this row is a cache of that computation,
/// not a second source of truth for it.
model NuruScore {
  profileId        String         @id
  profile          ProductProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category         String
  /// Component scores actually produced, e.g. {"battery": 82.5, "camera": 74}. Components
  /// with no scoreable data are simply absent, not zero — see nuru-score.ts.
  components       Json
  /// Null when nothing on the product could be scored at all.
  composite        Decimal?       @db.Decimal(5, 2)
  /// Which components contributed to `composite`, in schema component order.
  scoredComponents String[]
  /// Per-component { scoredWeight, totalWeight } — how much of the component's defined
  /// weight was actually backed by a resolved value, for a "based on N of M known
  /// factors" confidence read in the UI.
  coverage         Json
  /// Bumped when the scoring formulas themselves change, so a stale cached row from an
  /// old formula version can be told apart from one computed under the current rules.
  formulaVersion   Int            @default(1)
  computedAt       DateTime       @default(now())

  @@index([category])
}
