SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-api-token

# Handle of the Shopify Blog (Online Store > Blog Posts) that powers /blog.
# Defaults to "news" if unset.
SHOPIFY_BLOG_HANDLE=news

# Digits only, with country code, no + or spaces (e.g. 2547XXXXXXXX).
# The "Order via WhatsApp" button on product pages is hidden until this is set.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Real support inbox shown in the footer. The "Contact us" link is hidden
# until this is set — never hardcode a placeholder address here.
NEXT_PUBLIC_SUPPORT_EMAIL=

# From Shopify admin: Settings > Apps and sales channels > Headless > Customer
# Account API settings. Create a "Confidential" client with callback URL
# https://www.nuruelectronics.com/api/auth/callback. Customer sign-in is
# hidden and /api/auth/* routes no-op until both are set.
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_SECRET=

# Postgres connection string for the invoicing/records database (Prisma).
# e.g. a free Neon or Supabase Postgres instance.
DATABASE_URL=

# From Shopify admin: Settings > Apps and sales channels > Develop apps.
# Create a custom app with the `read_orders` scope (add `write_inventory` too
# if you enable the optional Shopify inventory sync). The admin order list and
# every "create from a live order" flow are hidden until this is set.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# Single-owner credentials for the /admin area (order documents, ledger,
# reports). All three must be set or /admin stays inaccessible.
# ADMIN_SESSION_SECRET should be a long random string (e.g. `openssl rand -hex 32`).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Set to "true" to redirect every storefront page to /maintenance (a
# "we'll be right back" splash). /admin and /api stay reachable so the site
# can still be managed and cron/webhook/email-linked routes keep working.
MAINTENANCE_MODE=

# Resend (https://resend.com) — used to email Estimates/Invoices/Receipts/
# Delivery Notes/Payslips as PDF attachments. DOCUMENT_EMAIL_FROM must be a
# verified sending address/domain in your Resend account.
RESEND_API_KEY=
DOCUMENT_EMAIL_FROM=

# Google service account (Sheets API enabled) shared as Editor on the target
# P&L spreadsheet, used by the daily cron sync and the admin "Sync now" button
# on /admin/reports/pnl. GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY should keep its
# literal "\n" line breaks (this app un-escapes them at runtime) — most
# platforms want the whole PEM block pasted as one line.
# PNL_SHEET_ID is the spreadsheet id from its URL (the store's target sheet is
# 1pAJrEMo7_QID6V62sA4C8XwGBHkxDTVX3wtYNE2fulI). PNL_SHEET_TAB is the *tab name*
# (bottom-of-screen sheet title), not the gid from the URL — open the sheet and
# copy its exact tab label.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
PNL_SHEET_ID=
PNL_SHEET_TAB=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it
# calls /api/cron/sync-pnl on the daily schedule in vercel.json (Vercel does
# this automatically once a CRON_SECRET env var exists — no extra setup).
# GCP Cloud Scheduler (used for /api/cron/capital-circle-cycle and
# /api/cron/product-readiness) needs the same secret but isn't wired up
# automatically — create it yourself, e.g.:
#   gcloud scheduler jobs create http product-readiness \
#     --schedule="0 8 * * *" \
#     --uri="https://<your-domain>/api/cron/product-readiness" \
#     --http-method=GET \
#     --headers="Authorization=Bearer <same value as CRON_SECRET>"
CRON_SECRET=

# Vertex AI (Gemini) — powers the shoppers concierge widget. Reuses the same
# GOOGLE_SERVICE_ACCOUNT_EMAIL/PRIVATE_KEY service account as the P&L Sheets
# sync above — grant it the "Vertex AI User" IAM role in GCP too, and make
# sure billing is enabled on the project (Gemini calls are billed; the
# Sheets-only setup may not have required that). The concierge launcher is
# hidden and /api/concierge/chat returns 503 until GOOGLE_SERVICE_ACCOUNT_EMAIL,
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY, GOOGLE_CLOUD_PROJECT, and
# GOOGLE_CLOUD_LOCATION are all set.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Google Analytics 4 measurement ID (Analytics admin > Data Streams > your
# web stream). Storefront-only (not /admin) — hidden entirely until set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Firestore-backed conversation memory for signed-in shoppers — reuses
# GOOGLE_SERVICE_ACCOUNT_EMAIL/PRIVATE_KEY/GOOGLE_CLOUD_PROJECT above, no new
# credentials. Requires: a Firestore database (Native mode) created in that
# GCP project, and the service account granted the "Cloud Datastore User"
# IAM role there. Also requires customer sign-in to actually be enabled (see
# SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID/SECRET above) — guests always get
# an ephemeral, unsaved conversation regardless of this.

# Capital Circle (see /admin/reports/capital-circle) — reuses the same
# Vertex AI credentials as the concierge above, no separate AI credentials.
# Polymarket market research needs no credentials at all (public endpoints).
# Everything below is Phase B only: leave unset and the weekly cycle runs in
# simulation mode (real markets, real reasoning, no real funds) — the only
# mode possible until Circle's mainnet/KYB signup is complete, since Circle
# wallet spending policies require a mainnet wallet (no testnet).
# CAPITAL_CIRCLE_LIVE must be "true" AND CIRCLE_API_KEY/CIRCLE_ENTITY_SECRET/
# CIRCLE_WALLET_ADDRESS must all be set for a real order to ever be placed —
# any one missing keeps every cycle in simulation mode.
# CIRCLE_API_KEY/CIRCLE_ENTITY_SECRET/CIRCLE_WALLET_ID/CIRCLE_WALLET_ADDRESS
# all come from running `node scripts/circle-wallet-setup.mjs` locally
# yourself (never in a shared session — it generates your Entity Secret,
# which must stay as secret as a private key). CIRCLE_WALLET_ID is Circle's
# own internal wallet id, not the same as the on-chain CIRCLE_WALLET_ADDRESS.
CAPITAL_CIRCLE_LIVE=false
CAPITAL_CIRCLE_DEFAULT_CAP_USD=25

# Whether the scoring model sees each outcome's current market price. Leave unset (true) to keep
# the price visible as a base rate. Set to "false" to score blind, which is worth doing if the
# report shows a high passthrough share: the code already blends the model's estimate with the
# market price via lambda, so a model that hands the price back has it counted twice and its
# estimate carries no information. Changing this changes what the desk trades — turn it on
# deliberately and watch it on its own.
CAPITAL_CIRCLE_SHOW_MARKET_PRICE=
# How many resolved candidate snapshots calibration is measured over. Shared by the trading cycle
# and the admin report so the lambda on the dashboard is the lambda actually gating trades.
CAPITAL_CIRCLE_CALIBRATION_SAMPLE_LIMIT=500
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=

# Weekly profit-sweep (see /api/cron/profit-sweep and the "Pending Sweeps"
# section of /admin/reports/capital-circle). CAPITAL_CIRCLE_SWEEP_PERCENT is
# the share of each week's real profit staged for conversion; the actual
# USD->USDC conversion and wallet funding always stays a manual step, so this
# only ever proposes a number for a human to confirm. CAPITAL_CIRCLE_OWNER_EMAIL
# is who gets notified each week a sweep is ready — leave unset and the sweep
# still gets recorded, just without an email.
CAPITAL_CIRCLE_SWEEP_PERCENT=40
CAPITAL_CIRCLE_OWNER_EMAIL=

# Set CAPITAL_CIRCLE_WALLET_NETWORK=testnet to run the whole wallet feature
# (chain.ts, the deposit QR, the balance panel, the readiness checklist)
# against Polygon Amoy instead of mainnet — a free, zero-risk dry run of the
# setup script below before touching real money. Leave unset for mainnet.
CAPITAL_CIRCLE_WALLET_NETWORK=

# `node scripts/circle-wallet-setup.mjs <command> --testnet` reads these four
# instead of the CIRCLE_* mainnet block above, and creates a Polygon Amoy
# testnet wallet. Contrary to an older version of this comment, the app
# itself DOES read all four whenever CAPITAL_CIRCLE_WALLET_NETWORK=testnet —
# circle-wallet-client.ts switches its entire credential set on that flag.
# What testnet still can't prove: the spending-policy circuit breaker
# (mainnet-only, per Circle's own CLI docs) or real Polymarket markets.
CIRCLE_TESTNET_API_KEY=
CIRCLE_TESTNET_ENTITY_SECRET=
CIRCLE_TESTNET_WALLET_ID=
CIRCLE_TESTNET_WALLET_ADDRESS=

# Optional. A dedicated Polygon RPC (Alchemy/Infura/QuickNode/etc) for the
# wallet balance panel's on-chain reads (onchain.ts). Unset is fine — those
# reads fall back to viem's public default endpoint, which is enough for the
# handful of eth_calls a 30s-cached balance panel makes. Set this if you see
# "rate-limited" or "timeout" readings there.
POLYGON_RPC_URL=

# The only way funds leave the Capital Circle wallet outside of live
# Polymarket trading itself (see "Withdraw to Binance" on the admin page).
# Destination is always BINANCE_DEPOSIT_ADDRESS — never caller-supplied —
# and capped at this amount per request regardless of what the underlying
# Circle transfer would otherwise allow.
CIRCLE_WALLET_WITHDRAW_CAP_USDC=10

# Lets the admin page pull USDC from Binance straight into the Capital
# Circle wallet ("Deposit from Binance"). Generate the API key in Binance's
# own dashboard with withdrawals restricted to BINANCE_DEPOSIT_ADDRESS and
# this server's IP — this app enforces its own BINANCE_WITHDRAW_CAP_USDC
# ceiling regardless of what the key itself is allowed to do, but a
# same-account destination-restricted key is still the real safety net.
# BINANCE_WITHDRAW_NETWORK overrides the network code binance-client.ts
# would otherwise resolve automatically from Binance's own coin-config API
# (only needed if that auto-resolution ever picks the wrong one — e.g. a
# legacy bridged variant alongside the current network, both named
# "Polygon"). Note: Binance has no listing for Polymarket's current
# collateral token (see CIRCLE_WALLET_ADDRESS's comment above and the
# deposit card's own warning) — this rail delivers plain USDC, which needs
# converting before it's usable as trading collateral.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_DEPOSIT_ADDRESS=
BINANCE_WITHDRAW_CAP_USDC=10
BINANCE_WITHDRAW_NETWORK=

# Optional: routes Binance calls through services/binance-relay instead of hitting
# api.binance.com directly — needed if this app's Vercel function region is one of Binance's
# "Restricted Locations" (the US among them), which returns HTTP 451 regardless of where the
# Binance account itself is actually based. Leave both unset to call Binance directly, unchanged
# from before this existed. If set, both are required — see services/binance-relay/README.md.
BINANCE_RELAY_URL=
BINANCE_RELAY_SECRET=

# x402 pay-per-call market data (x402-pay.ts, exposed to the model as
# fetch_paid_market_data) — fails closed by default. X402_ALLOWED_HOSTS is a
# comma-separated allowlist; leave empty and the tool is unreachable no
# matter what the model asks for. Each entry is "category:host", optionally
# pinning the expected payee address as "category:host=0xAddress":
#   X402_ALLOWED_HOSTS=news:api.example.com,sports-odds:odds.example.com=0xabc...
# The category is shown to the model (so it knows what's available) and used
# to look up a per-category price ceiling in X402_CATEGORY_CAPS_USDC
# ("category:amount", comma-separated) — a category with no entry there falls
# back to the flat X402_PAYMENT_CAP_USDC default below.
X402_ALLOWED_HOSTS=
X402_CATEGORY_CAPS_USDC=
X402_PAYMENT_CAP_USDC=0.50

# Daily product-readiness check (/api/cron/product-readiness, PDP audit #59) —
# flags active products missing an image, a real price, a real description, or
# SEO fields. PRODUCT_READINESS_OWNER_EMAIL is who gets notified when the check
# finds violations; leave unset and the check still runs and logs, just without
# an email. Needs the same SHOPIFY_STORE_DOMAIN/SHOPIFY_ADMIN_API_ACCESS_TOKEN
# as the rest of the Admin API integration (order sync, tax reports, etc.) —
# see those further up this file.
PRODUCT_READINESS_OWNER_EMAIL=

# Web Push for the Capital Circle admin page — a real-time "position taken" notification to the
# admin dashboard PWA (see public/admin-manifest.webmanifest), independent of the email report.
# Generate a keypair with `npx web-push generate-vapid-keys` and paste the two halves below.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is bundled into the client (it's public by design — that's what
# "public" VAPID key means); VAPID_PRIVATE_KEY must stay server-only, as secret as any API key.
# Leave both unset and the "Get notified" button on /admin/reports/capital-circle explains itself
# as unconfigured instead of erroring — no code path breaks without these.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI web-push puts in outgoing requests per the VAPID spec (a push service can use this
# to reach you about a misbehaving sender) — defaults to mailto:admin@nuruelectronics.com if unset.
VAPID_SUBJECT=
